# Copy this file to .env and fill in your values: cp env.example .env

# CoinGecko API key (https://www.coingecko.com/en/api/pricing)
# Wallet endpoints (portfolio, activity, PnL) need an Analyst plan key or above: COINGECKO_PLAN=pro
# With a free Demo key, set COINGECKO_PLAN=demo. Wallet creation, send and price charts still work.
COINGECKO_API_KEY=your_coingecko_api_key
COINGECKO_PLAN=pro

# Infura API key (https://www.infura.io/), used to connect to Ethereum Sepolia
INFURA_API_KEY=your_infura_api_key

# Optional: any Sepolia JSON-RPC URL. Overrides INFURA_API_KEY when set.
# ETH_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key
