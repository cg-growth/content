# Copy this file to .env and fill in your keys: cp env.example .env

# Flask session signing key: any long random string
FLASK_SECRET_KEY=replace-with-a-long-random-string

# Infura API key (https://www.infura.io/). Used to connect to Ethereum Sepolia.
INFURA_API_KEY=your_infura_api_key

# Optional: any Ethereum JSON-RPC URL. Overrides INFURA_API_KEY when set.
# ETH_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key

# CoinGecko Demo API key (https://www.coingecko.com/en/api/pricing)
COINGECKO_DEMO_API_KEY=your_coingecko_demo_api_key
