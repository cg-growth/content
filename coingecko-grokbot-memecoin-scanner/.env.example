# Copy the lines you need into files OUTSIDE this repo (never commit real values):
#   ~/.coingecko/keys.env        -> CoinGecko keys
#   ~/.grokbot-memecoin/keys.env -> Telegram + webhook settings
# On Grok Bot, store these as secrets instead; they arrive as environment variables.

# --- ~/.coingecko/keys.env ---
COINGECKO_PRO_API_KEY=
# CG_API_MODE=pro   (demo keys are not enough: onchain top traders/holders, wallet PnL and the WebSocket need Analyst or higher)

# --- ~/.grokbot-memecoin/keys.env ---
TELEGRAM_BOT_TOKEN=
# Optional: lock the bot to one chat (otherwise the first private chat that sends /start becomes the owner)
TELEGRAM_CHAT_ID=
# Optional: Grok Bot webhook routine for instant research + free-form chat (uses more Grok Bot quota)
TELEGRAM_FORWARD_URL=
TELEGRAM_FORWARD_KEY=

# --- optional, non-secret settings (can live in either file or your shell) ---
# MEMESCAN_TZ=Asia/Singapore      # IANA zone for timestamps + the 21:00 daily recap (default: machine local zone)
# PAPER_START_CASH=10000          # human paper book bankroll (AI book: auto/policy.json start_cash)
# PORT=8787                       # dashboard port (bound to 127.0.0.1; DASHBOARD_HOST to change)
# CHROME_BIN=/path/to/chrome      # headless Chrome/Chromium for portfolio/report cards
# MEMESCAN_UTM=0                  # disable UTM tags on CoinGecko/GeckoTerminal links
